{
  "name": "saldo-familiar",
  "version": "0.3.0",
  "private": true,
  "description": "Controle de despesas pessoais e orçamento familiar offline",
  "author": "Raphael Barros",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "node desktop/launch.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:ui": "node desktop/launch.cjs --smoke-test",
    "dist": "electron-builder --win nsis --x64"
  },
  "build": {
    "appId": "br.com.raphaelbarros.saldofamiliar",
    "productName": "Saldo Familiar",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**",
      "ui/**",
      "package.json",
      "node_modules/sql.js/**",
      "node_modules/exceljs/**"
    ],
    "win": {
      "target": "nsis",
      "signExecutable": false,
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Saldo-Familiar-${version}-Windows-x64.exe"
    }
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "sql.js": "^1.14.2"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  }
}
